<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Brand: Slate (from #6D8196) ===== -->
    <Color x:Key="Slate50">#F4F6F8</Color>
    <Color x:Key="Slate100">#E6EBF0</Color>
    <Color x:Key="Slate200">#CBD4DE</Color>
    <Color x:Key="Slate300">#A9B7C6</Color>
    <Color x:Key="Slate400">#8698AC</Color>
    <Color x:Key="Slate500">#6D8196</Color>  <!-- brand -->
    <Color x:Key="Slate600">#586B80</Color>
    <Color x:Key="Slate700">#475768</Color>
    <Color x:Key="Slate800">#364352</Color>
    <Color x:Key="Slate900">#252F3A</Color>
    <Color x:Key="Slate950">#161C23</Color>

    <!-- ===== Accent: Gold (the R) ===== -->
    <Color x:Key="Gold100">#FEF3C7</Color>
    <Color x:Key="Gold300">#FDE68A</Color>
    <Color x:Key="Gold400">#FBBF24</Color>
    <Color x:Key="Gold500">#F59E0B</Color>
    <Color x:Key="Gold600">#D97706</Color>
    <Color x:Key="Gold700">#B45309</Color>  <!-- gold text on light backgrounds -->

    <!-- ===== Roles ===== -->
    <Color x:Key="Primary">#6D8196</Color>          <!-- headers, splash, large brand areas -->
    <Color x:Key="PrimaryDark">#475768</Color>      <!-- buttons with white text (7.4:1) -->
    <Color x:Key="Accent">#FBBF24</Color>           <!-- FAB, highlights, active tab, charts -->
    <Color x:Key="OnAccent">#252F3A</Color>         <!-- text/icons on gold (8.1:1) -->

    <!-- ===== Money semantics ===== -->
    <Color x:Key="IncomeLight">#15803D</Color>
    <Color x:Key="IncomeDark">#4ADE80</Color>
    <Color x:Key="ExpenseLight">#DC2626</Color>
    <Color x:Key="ExpenseDark">#F87171</Color>
    <Color x:Key="Warning">#F59E0B</Color>          <!-- budget nearly used -->

    <!-- ===== Light theme surfaces & text ===== -->
    <Color x:Key="BackgroundLight">#F4F6F8</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="BorderLight">#E6EBF0</Color>
    <Color x:Key="TextPrimaryLight">#252F3A</Color>
    <Color x:Key="TextSecondaryLight">#586B80</Color>

    <!-- ===== Dark theme surfaces & text ===== -->
    <Color x:Key="BackgroundDark">#161C23</Color>
    <Color x:Key="SurfaceDark">#252F3A</Color>
    <Color x:Key="SurfaceRaisedDark">#364352</Color>
    <Color x:Key="BorderDark">#364352</Color>
    <Color x:Key="TextPrimaryDark">#F4F6F8</Color>
    <Color x:Key="TextSecondaryDark">#A9B7C6</Color>

    <!-- ===== Keys used by the MAUI template's Styles.xaml (mapped to the Rupeo palette) ===== -->
    <Color x:Key="PrimaryDarkText">#252F3A</Color>
    <Color x:Key="Secondary">#E6EBF0</Color>
    <Color x:Key="SecondaryDarkText">#364352</Color>
    <Color x:Key="Tertiary">#FBBF24</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D97706</Color>
    <Color x:Key="MidnightBlue">#252F3A</Color>
    <Color x:Key="OffBlack">#161C23</Color>
    <Color x:Key="Gray100">#E6EBF0</Color>
    <Color x:Key="Gray200">#CBD4DE</Color>
    <Color x:Key="Gray300">#A9B7C6</Color>
    <Color x:Key="Gray400">#8698AC</Color>
    <Color x:Key="Gray500">#6D8196</Color>
    <Color x:Key="Gray600">#586B80</Color>
    <Color x:Key="Gray900">#252F3A</Color>
    <Color x:Key="Gray950">#161C23</Color>

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <LinearGradientBrush x:Key="GoldGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FDE68A" Offset="0.0" />
        <GradientStop Color="#FBBF24" Offset="0.55" />
        <GradientStop Color="#F59E0B" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
