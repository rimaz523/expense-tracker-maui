<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="expense_tracker_maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:expense_tracker_maui"
    xmlns:views="clr-namespace:expense_tracker_maui.Views"
    Title="Rupeo"
    FlyoutBehavior="Flyout">

    <!-- Flyout header -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="{StaticResource Primary}" Padding="20,40,20,20">
            <VerticalStackLayout Spacing="4">
                <Label Text="Rupeo" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Gold400}" />
                <Label Text="Every cent on purpose" FontSize="14" TextColor="{StaticResource Gold500}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Main section: each ShellContent becomes a bottom tab AND a flyout entry -->
    <FlyoutItem Title="Main" Route="main" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent
            Title="Home"
            Icon="tab_home.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="home" />
        <ShellContent
            Title="Transactions"
            Icon="tab_transactions.png"
            ContentTemplate="{DataTemplate views:TransactionsPage}"
            Route="transactions" />
        <ShellContent
            Title="Budgets"
            Icon="tab_budgets.png"
            ContentTemplate="{DataTemplate views:BudgetsPage}"
            Route="budgets" />
        <ShellContent
            Title="Reports"
            Icon="tab_reports.png"
            ContentTemplate="{DataTemplate views:ReportsPage}"
            Route="reports" />
    </FlyoutItem>

    <!-- Flyout-only pages (no bottom tab bar) -->
    <FlyoutItem Title="Settings" Icon="tab_settings.png" Route="settings">
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="About" Icon="tab_about.png" Route="about">
        <ShellContent ContentTemplate="{DataTemplate views:AboutPage}" />
    </FlyoutItem>

</Shell>
